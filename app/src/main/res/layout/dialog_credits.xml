<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#ECEFF1"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/yellow_devil_muscle"
        android:scaleType="fitCenter"
        android:contentDescription="Logo"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Monster GYM v1.0"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Desarrollado por Mario García Rodríguez"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/blue_primary_dark"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Los personajes e ilustraciones están basados en recursos de video de Vecteezy:\nMonster Stock Videos by Vecteezy (https://www.vecteezy.com/free-videos/monster),\nsobre los cuales se han creado versiones personalizadas para la app."
        android:textSize="13sp"
        android:textColor="#37474F"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

</LinearLayout>